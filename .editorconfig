root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.html]
indent_style = tab
indent_size = 4
tab_width = 4

[res/icons/site-icons.svg]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{css,js,json,xml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
